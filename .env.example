DATABASE_URL=postgresql://postgres:password@localhost:5432/ltv
OPENAI_API_KEY=

# Infocare crawling account
INFOCARE_USER_ID=
INFOCARE_PASSWORD=

# Optional AI tuning
LTV_ADVISOR_MODEL=gpt-5-nano
LTV_USE_WEB_SEARCH=false
LTV_WEB_SEARCH_CONTEXT=high
LTV_ADVISOR_MAX_OUTPUT_TOKENS=2000
LTV_ADVISOR_REASONING_EFFORT=minimal
LTV_AI_CONCURRENCY=2
